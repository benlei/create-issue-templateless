{
  "name": "create-issue-templateless",
  "description": "Creates and update an issue like one would through an Issue Template, but without the template",
  "version": "1.6.0",
  "author": "benlei",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/benlei/create-issue-templateless",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benlei/create-issue-templateless.git"
  },
  "bugs": {
    "url": "https://github.com/benlei/create-issue-templateless/issues"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "npx vitest --run --coverage",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint . -c ./.github/linters/.eslintrc.yml",
    "package": "npx ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "package:watch": "npm run package -- --watch",
    "test": "npx vitest",
    "all": "npm run format:write && npm run lint && npm run ci-test && npm run coverage && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/core": "^7.0.6",
    "@octokit/plugin-paginate-rest": "^14.0.0",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/rest": "^22.0.1",
    "explode-env": "^1.3.1",
    "remarkable": "^2.0.1",
    "split-string": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/remarkable": "^2.0.8",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vercel/ncc": "^0.38.1",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^8.57.0",
    "eslint-plugin-jsonc": "^2.16.0",
    "eslint-plugin-prettier": "^5.2.1",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.3.3",
    "prettier-eslint": "^16.3.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.6"
  }
}
